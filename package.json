{
  "name": "@apnex/entity-graph",
  "version": "0.0.0",
  "private": true,
  "description": "Let an application declare once how its entities refer to one another and what must stay true of them, so it sees who refers to what as of a known position, and every edit, with all its consequences, lands whole or not at all and can be undone exactly.",
  "license": "MIT",
  "author": "apnex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apnex/entity-graph.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entity-store": {
      "types": "./dist/entity-store-port.d.ts",
      "default": "./dist/entity-store-port.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "docs:check": "tools/check-docs.sh",
    "vocabulary:check": "node tools/check-vocabulary.mjs"
  },
  "dependencies": {
    "@apnex/shape-check": "https://github.com/apnex/shape-check/releases/download/v0.2.0/apnex-shape-check-0.2.0.tgz"
  },
  "devDependencies": {
    "@apnex/entity-store": "https://github.com/apnex/entity-store/releases/download/v0.2.0/apnex-entity-store-0.2.0.tgz",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
