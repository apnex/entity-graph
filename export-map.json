{
  "package": "@apnex/entity-graph",
  "paths": {
    ".": {
      "exports": {
        "createEntityGraph": { "part": "entity-graph", "serves": ["dated-graph-view", "graph-declaration", "plan-graph-change", "reversible-history", "positioned-graph-sync"] },
        "createMemoryGraphPort": { "part": "entity-graph", "serves": ["reversible-history", "positioned-graph-sync"] },
        "GRAPH_LIMITS": { "part": "entity-graph", "serves": ["dated-graph-view"] }
      }
    },
    "./entity-store": {
      "exports": {
        "createEntityStorePort": { "part": "entity-graph", "serves": ["positioned-graph-sync"] }
      }
    }
  },
  "deferred": {}
}
