{
  "case": "b1-11-rule-breaches-reflected-as-placed",
  "batch": 1,
  "summary": "Changes from another writer that break declared rules are reflected as placed: an exclusive target held twice, targets of kinds the reference does not allow, and a reference below its minimum.",
  "covers": ["dated-graph-view", "positioned-graph-sync", "Reference rules"],
  "readings": ["R1", "R2", "R3", "R4", "R7"],
  "declare": {
    "kinds": [
      { "kind": "folder", "references": [
        { "field": "notes", "targets": ["note"], "holds": "many", "onTargetDelete": "unlink", "exclusivity": "refuse" }
      ] },
      { "kind": "note", "references": [
        { "field": "tags", "targets": ["tag"], "holds": "many", "onTargetDelete": "unlink", "onUnreferenced": "delete" },
        { "field": "author", "targets": ["owner"], "holds": "one", "onTargetDelete": "refuse" }
      ] },
      { "kind": "tag", "references": [] },
      { "kind": "owner", "references": [
        { "field": "folders", "targets": ["folder"], "holds": "many", "onTargetDelete": "unlink", "exclusivity": "steal", "min": 1, "onBelowMin": "cascade-delete" }
      ] }
    ]
  },
  "verdict": "accepted",
  "steps": [
    { "start": { "position": 0, "entities": [
      { "kind": "folder", "id": "f1", "record": { "title": "Inbox", "notes": ["n1"] } },
      { "kind": "folder", "id": "f2", "record": { "title": "Archive", "notes": [] } },
      { "kind": "note", "id": "n1", "record": { "title": "One", "tags": [], "author": null } },
      { "kind": "tag", "id": "t1", "record": { "title": "urgent" } },
      { "kind": "owner", "id": "o1", "record": { "title": "Ada", "folders": ["f1"] } }
    ] } },
    { "take": { "position": 1, "writes": [
      { "op": "put", "kind": "folder", "id": "f2", "record": { "title": "Archive", "notes": ["n1"] } }
    ] } },
    { "ask": { "position": 1, "questions": [
      { "q": "referrersOf", "id": "n1", "answer": [ { "kind": "folder", "id": "f1", "field": "notes" }, { "kind": "folder", "id": "f2", "field": "notes" } ] },
      { "q": "targetsOf", "id": "f2", "answer": [ { "field": "notes", "id": "n1" } ] },
      { "q": "targetsOf", "id": "f1", "answer": [ { "field": "notes", "id": "n1" } ] }
    ] } },
    { "take": { "position": 2, "writes": [
      { "op": "put", "kind": "note", "id": "n1", "record": { "title": "One", "tags": ["o1"], "author": "t1" } }
    ] } },
    { "ask": { "position": 2, "questions": [
      { "q": "referrersOf", "id": "t1", "answer": [ { "kind": "note", "id": "n1", "field": "author" } ] },
      { "q": "referrersOf", "id": "o1", "answer": [ { "kind": "note", "id": "n1", "field": "tags" } ] },
      { "q": "targetsOf", "id": "n1", "answer": [ { "field": "tags", "id": "o1" }, { "field": "author", "id": "t1" } ] },
      { "q": "targetsOf", "id": "n1", "field": "author", "answer": ["t1"] }
    ] } },
    { "take": { "position": 3, "writes": [
      { "op": "put", "kind": "owner", "id": "o1", "record": { "title": "Ada", "folders": [] } }
    ] } },
    { "ask": { "position": 3, "questions": [
      { "q": "get", "kind": "owner", "id": "o1", "answer": { "title": "Ada", "folders": [] } },
      { "q": "all", "kind": "owner", "answer": ["o1"] },
      { "q": "targetsOf", "id": "o1", "answer": [] },
      { "q": "referrersOf", "id": "f1", "answer": [] },
      { "q": "referrersOf", "id": "o1", "answer": [ { "kind": "note", "id": "n1", "field": "tags" } ] }
    ] } }
  ]
}
