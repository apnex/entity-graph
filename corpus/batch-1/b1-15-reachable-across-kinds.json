{
  "case": "b1-15-reachable-across-kinds",
  "batch": 1,
  "summary": "reachable follows every reference field of every kind, through a cycle that crosses three kinds, and shrinks when one reference of the cycle is cleared.",
  "covers": ["dated-graph-view", "positioned-graph-sync"],
  "readings": ["R1", "R2", "R5", "R5a", "R7"],
  "declare": {
    "kinds": [
      { "kind": "folder", "references": [
        { "field": "notes", "targets": ["note"], "holds": "many", "onTargetDelete": "unlink", "exclusivity": "refuse" }
      ] },
      { "kind": "note", "references": [
        { "field": "tags", "targets": ["tag"], "holds": "many", "onTargetDelete": "unlink", "onUnreferenced": "delete" },
        { "field": "author", "targets": ["owner"], "holds": "one", "onTargetDelete": "refuse" }
      ] },
      { "kind": "tag", "references": [] },
      { "kind": "owner", "references": [
        { "field": "folders", "targets": ["folder"], "holds": "many", "onTargetDelete": "unlink", "exclusivity": "steal" }
      ] }
    ]
  },
  "verdict": "accepted",
  "steps": [
    { "start": { "position": 0, "entities": [
      { "kind": "owner", "id": "o1", "record": { "title": "Ada", "folders": ["f1"] } },
      { "kind": "owner", "id": "o2", "record": { "title": "Grace", "folders": [] } },
      { "kind": "folder", "id": "f1", "record": { "title": "Inbox", "notes": ["n1", "n2"] } },
      { "kind": "note", "id": "n1", "record": { "title": "One", "tags": ["t1"], "author": "o1" } },
      { "kind": "note", "id": "n2", "record": { "title": "Two", "tags": ["t2"], "author": "o2" } },
      { "kind": "tag", "id": "t1", "record": { "title": "urgent" } },
      { "kind": "tag", "id": "t2", "record": { "title": "later" } }
    ] } },
    { "ask": { "position": 0, "questions": [
      { "q": "reachable", "from": "o1", "answer": ["o1", "f1", "n1", "n2", "t1", "t2", "o2"] },
      { "q": "reachable", "from": "f1", "answer": ["o1", "f1", "n1", "n2", "t1", "t2", "o2"] },
      { "q": "reachable", "from": "n1", "answer": ["o1", "f1", "n1", "n2", "t1", "t2", "o2"] },
      { "q": "reachable", "from": "n2", "answer": ["t2", "o2"] },
      { "q": "reachable", "from": "o2", "answer": [] },
      { "q": "reachable", "from": "t1", "answer": [] }
    ] } },
    { "take": { "position": 1, "writes": [
      { "op": "put", "kind": "note", "id": "n1", "record": { "title": "One", "tags": ["t1"], "author": null } }
    ] } },
    { "ask": { "position": 1, "questions": [
      { "q": "reachable", "from": "o1", "answer": ["f1", "n1", "n2", "t1", "t2", "o2"] },
      { "q": "reachable", "from": "f1", "answer": ["n1", "n2", "t1", "t2", "o2"] },
      { "q": "reachable", "from": "n1", "answer": ["t1"] },
      { "q": "reachable", "from": "n2", "answer": ["t2", "o2"] }
    ] } }
  ]
}
