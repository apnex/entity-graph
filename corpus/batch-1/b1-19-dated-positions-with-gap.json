{
  "case": "b1-19-dated-positions-with-gap",
  "batch": 1,
  "summary": "Every answer is dated to the position of the last change taken in, across a change to plain data only and a gap in the positions.",
  "covers": ["dated-graph-view", "positioned-graph-sync"],
  "readings": ["R1", "R2", "R7", "R7a"],
  "declare": {
    "kinds": [
      { "kind": "folder", "references": [
        { "field": "notes", "targets": ["note"], "holds": "many", "onTargetDelete": "unlink", "exclusivity": "refuse" }
      ] },
      { "kind": "note", "references": [
        { "field": "tags", "targets": ["tag"], "holds": "many", "onTargetDelete": "unlink", "onUnreferenced": "delete" },
        { "field": "author", "targets": ["owner"], "holds": "one", "onTargetDelete": "refuse" }
      ] },
      { "kind": "tag", "references": [] },
      { "kind": "owner", "references": [
        { "field": "folders", "targets": ["folder"], "holds": "many", "onTargetDelete": "unlink", "exclusivity": "steal" }
      ] }
    ]
  },
  "verdict": "accepted",
  "steps": [
    { "start": { "position": 10, "entities": [
      { "kind": "tag", "id": "t1", "record": { "title": "urgent" } },
      { "kind": "note", "id": "n1", "record": { "title": "a", "tags": ["t1"], "author": null } }
    ] } },
    { "ask": { "position": 10, "questions": [
      { "q": "referrersOf", "id": "t1", "answer": [ { "kind": "note", "id": "n1", "field": "tags" } ] },
      { "q": "get", "kind": "note", "id": "n1", "answer": { "title": "a", "tags": ["t1"], "author": null } }
    ] } },
    { "take": { "position": 11, "writes": [
      { "op": "put", "kind": "note", "id": "n1", "record": { "title": "b", "tags": ["t1"], "author": null } }
    ] } },
    { "ask": { "position": 11, "questions": [
      { "q": "referrersOf", "id": "t1", "answer": [ { "kind": "note", "id": "n1", "field": "tags" } ] },
      { "q": "get", "kind": "note", "id": "n1", "answer": { "title": "b", "tags": ["t1"], "author": null } }
    ] } },
    { "take": { "position": 15, "writes": [
      { "op": "put", "kind": "tag", "id": "t2", "record": { "title": "later" } },
      { "op": "put", "kind": "note", "id": "n1", "record": { "title": "b", "tags": ["t1", "t2"], "author": null } }
    ] } },
    { "ask": { "position": 15, "questions": [
      { "q": "referrersOf", "id": "t2", "answer": [ { "kind": "note", "id": "n1", "field": "tags" } ] },
      { "q": "targetsOf", "id": "n1", "field": "tags", "answer": ["t1", "t2"] },
      { "q": "all", "kind": "tag", "answer": ["t1", "t2"] }
    ] } },
    { "take": { "position": 16, "writes": [
      { "op": "put", "kind": "note", "id": "n1", "record": { "title": "b", "tags": ["t2"], "author": null } }
    ] } },
    { "ask": { "position": 16, "questions": [
      { "q": "referrersOf", "id": "t1", "answer": [] },
      { "q": "referrersOf", "id": "t2", "answer": [ { "kind": "note", "id": "n1", "field": "tags" } ] },
      { "q": "targetsOf", "id": "n1", "answer": [ { "field": "tags", "id": "t2" } ] }
    ] } }
  ]
}
