{
  "case": "b1-12-owner-of-gathering-list",
  "batch": 1,
  "summary": "ownerOf answers the one entity of the asked kind whose list holds the member, null when none of that kind does, follows a move between lists, and still finds a holder of a removed member.",
  "covers": ["dated-graph-view", "positioned-graph-sync"],
  "readings": ["R1", "R2", "R3", "R4", "R6", "R7"],
  "declare": {
    "kinds": [
      { "kind": "folder", "references": [
        { "field": "notes", "targets": ["note"], "holds": "many", "onTargetDelete": "unlink", "exclusivity": "refuse" }
      ] },
      { "kind": "note", "references": [
        { "field": "tags", "targets": ["tag"], "holds": "many", "onTargetDelete": "unlink", "onUnreferenced": "delete" },
        { "field": "author", "targets": ["owner"], "holds": "one", "onTargetDelete": "refuse" }
      ] },
      { "kind": "tag", "references": [] },
      { "kind": "owner", "references": [
        { "field": "folders", "targets": ["folder"], "holds": "many", "onTargetDelete": "unlink", "exclusivity": "steal" }
      ] }
    ]
  },
  "verdict": "accepted",
  "steps": [
    { "start": { "position": 0, "entities": [
      { "kind": "owner", "id": "o1", "record": { "title": "Ada", "folders": ["f1", "f2"] } },
      { "kind": "folder", "id": "f1", "record": { "title": "Inbox", "notes": ["n1", "n2"] } },
      { "kind": "folder", "id": "f2", "record": { "title": "Archive", "notes": ["n3"] } },
      { "kind": "tag", "id": "t1", "record": { "title": "urgent" } },
      { "kind": "note", "id": "n1", "record": { "title": "One", "tags": ["t1"], "author": null } },
      { "kind": "note", "id": "n2", "record": { "title": "Two", "tags": [], "author": null } },
      { "kind": "note", "id": "n3", "record": { "title": "Three", "tags": [], "author": null } },
      { "kind": "note", "id": "n4", "record": { "title": "Four", "tags": [], "author": null } }
    ] } },
    { "ask": { "position": 0, "questions": [
      { "q": "ownerOf", "member": "n1", "containerKind": "folder", "answer": "f1" },
      { "q": "ownerOf", "member": "n2", "containerKind": "folder", "answer": "f1" },
      { "q": "ownerOf", "member": "n3", "containerKind": "folder", "answer": "f2" },
      { "q": "ownerOf", "member": "n4", "containerKind": "folder", "answer": null },
      { "q": "ownerOf", "member": "n1", "containerKind": "owner", "answer": null },
      { "q": "ownerOf", "member": "f1", "containerKind": "owner", "answer": "o1" },
      { "q": "ownerOf", "member": "t1", "containerKind": "note", "answer": "n1" },
      { "q": "ownerOf", "member": "t1", "containerKind": "folder", "answer": null },
      { "q": "ownerOf", "member": "o1", "containerKind": "folder", "answer": null }
    ] } },
    { "take": { "position": 1, "writes": [
      { "op": "put", "kind": "folder", "id": "f1", "record": { "title": "Inbox", "notes": ["n1"] } },
      { "op": "put", "kind": "folder", "id": "f2", "record": { "title": "Archive", "notes": ["n3", "n2"] } }
    ] } },
    { "ask": { "position": 1, "questions": [
      { "q": "ownerOf", "member": "n2", "containerKind": "folder", "answer": "f2" },
      { "q": "ownerOf", "member": "n1", "containerKind": "folder", "answer": "f1" },
      { "q": "referrersOf", "id": "n2", "answer": [ { "kind": "folder", "id": "f2", "field": "notes" } ] }
    ] } },
    { "take": { "position": 2, "writes": [
      { "op": "del", "kind": "folder", "id": "f2" }
    ] } },
    { "ask": { "position": 2, "questions": [
      { "q": "ownerOf", "member": "n3", "containerKind": "folder", "answer": null },
      { "q": "ownerOf", "member": "n2", "containerKind": "folder", "answer": null },
      { "q": "ownerOf", "member": "n1", "containerKind": "folder", "answer": "f1" },
      { "q": "ownerOf", "member": "f2", "containerKind": "owner", "answer": "o1" }
    ] } }
  ]
}
