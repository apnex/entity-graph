  "declare": {
    "kinds": [
      { "kind": "folder", "references": [
        { "field": "notes", "targets": ["note"], "holds": "many", "onTargetDelete": "unlink" }
      ] },
      { "kind": "note", "references": [
        { "field": "tags", "holds": "many", "onTargetDelete": "unlink" }
      ] },
      { "kind": "tag", "references": [] }
    ]
  },
  "verdict": "refused",
  "refusal": { "reason": "no-target-kind", "part": "entity-graph", "names": ["note", "tags"] }
