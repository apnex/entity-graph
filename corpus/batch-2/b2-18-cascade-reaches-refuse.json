{
  "case": "b2-18-cascade-reaches-refuse",
  "batch": 2,
  "summary": "In a three-item edit, the removal at index 2 cascades to a figure another section cites, so the edit is refused at index 2, naming the citing section the edit never named; dropping the citation in the same edit is accepted.",
  "covers": ["plan-graph-change", "Reference rules", "Judging and refusals", "Consequences and the stopping rule"],
