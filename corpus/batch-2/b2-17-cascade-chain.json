{
  "case": "b2-17-cascade-chain",
  "batch": 2,
  "summary": "Removing a section deletes its subsection, the figures in both, and their captions, a chain of cascades three deep; removing a figure takes only its caption.",
  "covers": ["plan-graph-change", "Reference rules", "Consequences and the stopping rule"],
  "readings": ["R1", "R2", "R14", "R15", "R17", "R23"],
  "declare": {
    "kinds": [
      { "kind": "section", "references": [
        { "field": "parent", "targets": ["section"], "holds": "one", "onTargetDelete": "cascade-delete" },
        { "field": "cites", "targets": ["figure"], "holds": "many", "onTargetDelete": "refuse" }
      ] },
      { "kind": "figure", "references": [
        { "field": "section", "targets": ["section"], "holds": "one", "onTargetDelete": "cascade-delete" }
      ] },
      { "kind": "caption", "references": [
        { "field": "figure", "targets": ["figure"], "holds": "one", "onTargetDelete": "cascade-delete", "exclusivity": "refuse" }
      ] }
    ]
  },
  "verdict": "accepted",
  "steps": [
    { "start": { "position": 0, "entities": [
      { "kind": "section", "id": "s1", "record": { "heading": "Intro", "parent": null, "cites": [] } },
      { "kind": "section", "id": "s2", "record": { "heading": "Background", "parent": "s1", "cites": [] } },
      { "kind": "section", "id": "s3", "record": { "heading": "Method", "parent": null, "cites": [] } },
      { "kind": "figure", "id": "f1", "record": { "title": "Map", "section": "s1" } },
      { "kind": "figure", "id": "f2", "record": { "title": "Chart", "section": "s2" } },
      { "kind": "figure", "id": "f3", "record": { "title": "Plot", "section": "s3" } },
      { "kind": "caption", "id": "c1", "record": { "body": "A map", "figure": "f1" } },
      { "kind": "caption", "id": "c2", "record": { "body": "A chart", "figure": "f2" } }
    ] } },
    { "plan": { "position": 0, "edit": [
      { "op": "remove", "kind": "section", "id": "s1" }
    ], "outcome": "accepted", "writes": [
      { "op": "del", "kind": "section", "id": "s1" },
      { "op": "del", "kind": "section", "id": "s2" },
      { "op": "del", "kind": "figure", "id": "f1" },
      { "op": "del", "kind": "figure", "id": "f2" },
      { "op": "del", "kind": "caption", "id": "c1" },
      { "op": "del", "kind": "caption", "id": "c2" }
    ] } },
    { "plan": { "position": 0, "edit": [
      { "op": "remove", "kind": "figure", "id": "f2" }
    ], "outcome": "accepted", "writes": [
      { "op": "del", "kind": "figure", "id": "f2" },
      { "op": "del", "kind": "caption", "id": "c2" }
    ] } },
    { "plan": { "position": 0, "edit": [
      { "op": "remove", "kind": "caption", "id": "c1" }
    ], "outcome": "accepted", "writes": [
      { "op": "del", "kind": "caption", "id": "c1" }
    ] } },
    { "ask": { "position": 0, "questions": [
      { "q": "all", "kind": "section", "answer": ["s1", "s2", "s3"] },
      { "q": "all", "kind": "caption", "answer": ["c1", "c2"] }
    ] } }
  ]
}
