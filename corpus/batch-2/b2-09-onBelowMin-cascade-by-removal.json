{
  "case": "b2-09-onBelowMin-cascade-by-removal",
  "batch": 2,
  "summary": "Removing a member unlinks it, a team left below its minimum is deleted and the task assigned to it unlinked, while a team left at its minimum is only changed.",
  "covers": ["plan-graph-change", "Reference rules", "Consequences and the stopping rule"],
  "readings": ["R1", "R2", "R14", "R15", "R16", "R17", "R23"],
  "declare": {
    "kinds": [
      { "kind": "person", "references": [] },
      { "kind": "team", "references": [
        { "field": "members", "targets": ["person"], "holds": "many", "onTargetDelete": "unlink", "exclusivity": "steal", "min": 2, "onBelowMin": "cascade-delete" }
      ] },
      { "kind": "committee", "references": [
        { "field": "members", "targets": ["person"], "holds": "many", "onTargetDelete": "unlink", "exclusivity": "steal", "min": 2, "onBelowMin": "refuse" }
      ] },
      { "kind": "task", "references": [
        { "field": "waitsOn", "targets": ["task"], "holds": "many", "onTargetDelete": "unlink" },
        { "field": "assignee", "targets": ["team"], "holds": "one", "onTargetDelete": "unlink", "onUnreferenced": "keep" },
        { "field": "owner", "targets": ["person"], "holds": "one", "onTargetDelete": "unlink", "exclusivity": "steal" }
      ] }
    ]
  },
  "verdict": "accepted",
  "steps": [
    { "start": { "position": 2, "entities": [
      { "kind": "person", "id": "p3", "record": { "name": "Kim" } },
      { "kind": "person", "id": "p4", "record": { "name": "Max" } },
      { "kind": "person", "id": "p5", "record": { "name": "Sol" } },
      { "kind": "person", "id": "p6", "record": { "name": "Ira" } },
      { "kind": "person", "id": "p7", "record": { "name": "Uma" } },
      { "kind": "team", "id": "tm2", "record": { "name": "Docs", "members": ["p3", "p4"] } },
      { "kind": "team", "id": "tm3", "record": { "name": "Ops", "members": ["p5", "p6", "p7"] } },
      { "kind": "task", "id": "t2", "record": { "title": "Write", "waitsOn": [], "assignee": "tm2", "owner": null } }
    ] } },
    { "plan": { "position": 2, "edit": [
      { "op": "remove", "kind": "person", "id": "p3" }
    ], "outcome": "accepted", "writes": [
      { "op": "del", "kind": "person", "id": "p3" },
      { "op": "del", "kind": "team", "id": "tm2" },
      { "op": "put", "kind": "task", "id": "t2", "record": { "title": "Write", "waitsOn": [], "assignee": null, "owner": null } }
    ] } },
    { "plan": { "position": 2, "edit": [
      { "op": "remove", "kind": "person", "id": "p5" }
    ], "outcome": "accepted", "writes": [
      { "op": "del", "kind": "person", "id": "p5" },
      { "op": "put", "kind": "team", "id": "tm3", "record": { "name": "Ops", "members": ["p6", "p7"] } }
    ] } },
    { "plan": { "position": 2, "edit": [
      { "op": "change", "kind": "team", "id": "tm2", "record": { "name": "Docs", "members": ["p4"] } }
    ], "outcome": "accepted", "writes": [
      { "op": "del", "kind": "team", "id": "tm2" },
      { "op": "put", "kind": "task", "id": "t2", "record": { "title": "Write", "waitsOn": [], "assignee": null, "owner": null } }
    ] } },
    { "ask": { "position": 2, "questions": [
      { "q": "all", "kind": "team", "answer": ["tm2", "tm3"] },
      { "q": "all", "kind": "person", "answer": ["p3", "p4", "p5", "p6", "p7"] }
    ] } }
  ]
}
