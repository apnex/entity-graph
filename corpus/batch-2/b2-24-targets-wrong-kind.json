{
  "case": "b2-24-targets-wrong-kind",
  "batch": 2,
  "summary": "A requested reference to an entity of a kind the reference may not target is refused, through a one-target and through a list reference, and one to an allowed kind is accepted.",
  "covers": ["plan-graph-change", "Reference rules", "Judging and refusals"],
  "readings": ["R1", "R2", "R14", "R15", "R18", "R19", "R21", "R23", "R24"],
  "declare": {
    "kinds": [
      { "kind": "section", "references": [
        { "field": "parent", "targets": ["section"], "holds": "one", "onTargetDelete": "cascade-delete" },
