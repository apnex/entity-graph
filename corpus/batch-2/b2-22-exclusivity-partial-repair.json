{
  "case": "b2-22-exclusivity-partial-repair",
  "batch": 2,
  "summary": "A figure already holding three captions may lose one or two, may have one of them changed without raising the breach, and an unrelated edit leaves it as it is.",
  "covers": ["plan-graph-change", "Reference rules", "Judging and refusals"],
  "readings": ["R1", "R2", "R3", "R14", "R15", "R17", "R18", "R23"],
  "declare": {
    "kinds": [
      { "kind": "section", "references": [
        { "field": "parent", "targets": ["section"], "holds": "one", "onTargetDelete": "cascade-delete" },
        { "field": "cites", "targets": ["figure"], "holds": "many", "onTargetDelete": "refuse" }
      ] },
      { "kind": "figure", "references": [
        { "field": "section", "targets": ["section"], "holds": "one", "onTargetDelete": "cascade-delete" }
      ] },
      { "kind": "caption", "references": [
        { "field": "figure", "targets": ["figure"], "holds": "one", "onTargetDelete": "cascade-delete", "exclusivity": "refuse" }
      ] }
    ]
  },
  "verdict": "accepted",
  "steps": [
    { "start": { "position": 0, "entities": [
      { "kind": "section", "id": "s1", "record": { "heading": "Intro", "parent": null, "cites": [] } },
      { "kind": "figure", "id": "f1", "record": { "title": "Map", "section": "s1" } },
      { "kind": "caption", "id": "c1", "record": { "body": "Map, first", "figure": "f1" } },
      { "kind": "caption", "id": "c2", "record": { "body": "Map, second", "figure": "f1" } },
      { "kind": "caption", "id": "c3", "record": { "body": "Map, third", "figure": "f1" } }
    ] } },
    { "plan": { "position": 0, "edit": [
      { "op": "remove", "kind": "caption", "id": "c3" }
    ], "outcome": "accepted", "writes": [
      { "op": "del", "kind": "caption", "id": "c3" }
    ] } },
    { "plan": { "position": 0, "edit": [
      { "op": "remove", "kind": "caption", "id": "c2" },
      { "op": "remove", "kind": "caption", "id": "c3" }
    ], "outcome": "accepted", "writes": [
      { "op": "del", "kind": "caption", "id": "c2" },
      { "op": "del", "kind": "caption", "id": "c3" }
    ] } },
    { "plan": { "position": 0, "edit": [
      { "op": "change", "kind": "caption", "id": "c3", "record": { "body": "Map, last", "figure": "f1" } }
    ], "outcome": "accepted", "writes": [
      { "op": "put", "kind": "caption", "id": "c3", "record": { "body": "Map, last", "figure": "f1" } }
    ] } },
    { "plan": { "position": 0, "edit": [
      { "op": "create", "kind": "section", "id": "s2", "record": { "heading": "Notes", "parent": null, "cites": [] } }
    ], "outcome": "accepted", "writes": [
      { "op": "put", "kind": "section", "id": "s2", "record": { "heading": "Notes", "parent": null, "cites": [] } }
    ] } },
    { "ask": { "position": 0, "questions": [
      { "q": "referrersOf", "id": "f1", "answer": [ { "kind": "caption", "id": "c1", "field": "figure" }, { "kind": "caption", "id": "c2", "field": "figure" }, { "kind": "caption", "id": "c3", "field": "figure" } ] }
    ] } }
  ]
}
